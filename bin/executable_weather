#!/usr/bin/env bash
for entry in 'Wilmington,NC,USA|Wilmington, NC' 'California,MD,USA|California, MD' 'Dumfries,VA|Dumfries, VA' 'Williamsburg,VA|Williamsburg, VA' 'Manassas,VA|Manassas, VA'; do IFS='|' read -r q label <<< "$entry"; printf '%-18s %s\n' "$label:" "$(curl -s "https://wttr.in/${q}?format=%t+%C+(%h)")"; done
